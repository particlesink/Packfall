SHELL := /bin/bash

.PHONY: all headers stubs clean print-config help lib shlib

TARGET ?= packfall
BUILD_DIR ?= ../build/linux
OBJ_DIR := $(BUILD_DIR)/obj
DEP_DIR := $(BUILD_DIR)/dep
STUB_DIR := $(BUILD_DIR)/stubs
PIC_OBJ_DIR := $(BUILD_DIR)/obj-shlib
PIC_DEP_DIR := $(BUILD_DIR)/dep-shlib
PIC_STUB_DIR := $(BUILD_DIR)/stubs-shlib
EXE := $(BUILD_DIR)/$(TARGET)
STATIC_LIB := $(BUILD_DIR)/lib$(TARGET).a
SHARED_LIB := $(BUILD_DIR)/lib$(TARGET).so
HEADER_STAMP := $(BUILD_DIR)/.headers.stamp

AR ?= ar
OPT ?= -O2
STD ?= -std=gnu++17
WARN ?= -Wall -Wextra -Wno-unused-result -Wno-unused-parameter
PICFLAGS ?= -fPIC
SHLIBFLAGS ?= -shared

# Build mode:
#   USE_MPI=0 -> default single-process build against the MPI shim in src/STUBS
#   USE_MPI=1 -> opt in to the Linux MPI wrapper compiler
USE_MPI ?= 0
MPICXX ?= mpic++
SERIAL_CXX ?= g++

# Feature toggles:
#   ENABLE_GZIP=1 enables reading/writing .gz files via the gzip executable.
ENABLE_GZIP ?= 0
ENABLE_SUPERQUADRICS ?= 1

FEATURE_DEFS := -DLAMMPS_VTK
ifeq ($(ENABLE_GZIP),1)
FEATURE_DEFS += -DLAMMPS_GZIP
endif
ifeq ($(ENABLE_SUPERQUADRICS),1)
FEATURE_DEFS += -DSUPERQUADRIC_ACTIVE_FLAG -DNONSPHERICAL_ACTIVE_FLAG
endif

MPI_CPPFLAGS :=
MPI_LDFLAGS :=
MPI_LDLIBS :=
STUB_TARGET :=
PIC_STUB_TARGET :=

ifeq ($(USE_MPI),1)
CXX := $(MPICXX)
LINK := $(MPICXX)
MPI_MODE := wrapper
else
CXX := $(SERIAL_CXX)
LINK := $(SERIAL_CXX)
MPI_MODE := stubs
MPI_CPPFLAGS += -ISTUBS
MPI_LDFLAGS += -L$(STUB_DIR)
MPI_LDLIBS += -lmpi_stubs
STUB_TARGET := $(STUB_DIR)/libmpi_stubs.a
endif

ifeq ($(USE_MPI),0)
PIC_STUB_TARGET := $(PIC_STUB_DIR)/libmpi_stubs.a
endif

CPPFLAGS += -I. $(FEATURE_DEFS) $(MPI_CPPFLAGS) $(EXTRA_CPPFLAGS)
CXXFLAGS += $(STD) $(OPT) $(WARN) $(EXTRA_CXXFLAGS)
LDFLAGS += $(MPI_LDFLAGS) $(EXTRA_LDFLAGS)
LDLIBS += $(MPI_LDLIBS) $(EXTRA_LDLIBS)
SHLIB_LDFLAGS := $(filter-out -L$(STUB_DIR),$(LDFLAGS))
ifeq ($(USE_MPI),0)
SHLIB_LDFLAGS += -L$(PIC_STUB_DIR)
endif

SRC := $(wildcard *.cpp)
OBJ := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(SRC))
LIB_SRC := $(filter-out main.cpp,$(SRC))
LIB_OBJ := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(LIB_SRC))
DEP := $(patsubst %.cpp,$(DEP_DIR)/%.d,$(SRC))
PIC_LIB_OBJ := $(patsubst %.cpp,$(PIC_OBJ_DIR)/%.o,$(LIB_SRC))
PIC_LIB_DEP := $(patsubst %.cpp,$(PIC_DEP_DIR)/%.d,$(LIB_SRC))

all: $(EXE)
lib: $(STATIC_LIB)
shlib: $(SHARED_LIB)

help:
	@echo "Linux build targets:"
	@echo "  make -f Makefile.linux                  build single-process with the MPI shim"
	@echo "  make -f Makefile.linux USE_MPI=1        opt in to a real MPI toolchain"
	@echo "  make -f Makefile.linux lib             build a static library"
	@echo "  make -f Makefile.linux shlib           build a shared library for Python/C callers"
	@echo "  make -f Makefile.linux print-config     show resolved toolchain settings"

print-config:
	@echo "TARGET=$(TARGET)"
	@echo "EXE=$(EXE)"
	@echo "STATIC_LIB=$(STATIC_LIB)"
	@echo "SHARED_LIB=$(SHARED_LIB)"
	@echo "USE_MPI=$(USE_MPI)"
	@echo "MPI_MODE=$(MPI_MODE)"
	@echo "CXX=$(CXX)"
	@echo "LINK=$(LINK)"
	@echo "CPPFLAGS=$(CPPFLAGS)"
	@echo "CXXFLAGS=$(CXXFLAGS)"
	@echo "LDFLAGS=$(LDFLAGS)"
	@echo "LDLIBS=$(LDLIBS)"
	@echo "ENABLE_GZIP=$(ENABLE_GZIP)"
	@echo "ENABLE_SUPERQUADRICS=$(ENABLE_SUPERQUADRICS)"

headers: $(HEADER_STAMP)

stubs: $(STUB_TARGET)

$(STUB_TARGET):
	@mkdir -p $(STUB_DIR)
	$(SERIAL_CXX) -O -c STUBS/mpi.c -o $(STUB_DIR)/mpi.o
	$(AR) rs $@ $(STUB_DIR)/mpi.o

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

$(OBJ_DIR):
	@mkdir -p $(OBJ_DIR)

$(DEP_DIR):
	@mkdir -p $(DEP_DIR)

$(STUB_DIR):
	@mkdir -p $(STUB_DIR)

$(PIC_OBJ_DIR):
	@mkdir -p $(PIC_OBJ_DIR)

$(PIC_DEP_DIR):
	@mkdir -p $(PIC_DEP_DIR)

$(PIC_STUB_DIR):
	@mkdir -p $(PIC_STUB_DIR)

ifeq ($(USE_MPI),0)
$(PIC_STUB_TARGET): | $(PIC_STUB_DIR)
	$(SERIAL_CXX) -O $(PICFLAGS) -c STUBS/mpi.c -o $(PIC_STUB_DIR)/mpi.o
	$(AR) rs $@ $(PIC_STUB_DIR)/mpi.o
endif

$(HEADER_STAMP): | $(BUILD_DIR)
	@bash Make.sh style
	@bash Make.sh models
	@touch $@

$(EXE): $(HEADER_STAMP) $(STUB_TARGET) | $(BUILD_DIR) $(OBJ_DIR) $(DEP_DIR) $(STUB_DIR)
$(EXE): $(OBJ)
	$(LINK) $(CXXFLAGS) $(OBJ) $(LDFLAGS) $(LDLIBS) -o $@

$(STATIC_LIB): $(HEADER_STAMP) $(STUB_TARGET) | $(BUILD_DIR) $(OBJ_DIR) $(DEP_DIR) $(STUB_DIR)
$(STATIC_LIB): $(LIB_OBJ)
	$(AR) rs $@ $(LIB_OBJ)

$(SHARED_LIB): $(HEADER_STAMP) $(PIC_STUB_TARGET) | $(BUILD_DIR) $(PIC_OBJ_DIR) $(PIC_DEP_DIR) $(PIC_STUB_DIR)
$(SHARED_LIB): $(PIC_LIB_OBJ)
	$(LINK) $(CXXFLAGS) $(SHLIBFLAGS) $(PIC_LIB_OBJ) $(SHLIB_LDFLAGS) $(LDLIBS) -o $@

$(OBJ_DIR)/%.o: %.cpp $(HEADER_STAMP) $(STUB_TARGET) | $(OBJ_DIR) $(DEP_DIR) $(STUB_DIR)
	@mkdir -p $(OBJ_DIR) $(DEP_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MF $(DEP_DIR)/$*.d -c $< -o $@

$(PIC_OBJ_DIR)/%.o: %.cpp $(HEADER_STAMP) $(PIC_STUB_TARGET) | $(PIC_OBJ_DIR) $(PIC_DEP_DIR) $(PIC_STUB_DIR)
	@mkdir -p $(PIC_OBJ_DIR) $(PIC_DEP_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(PICFLAGS) -MMD -MF $(PIC_DEP_DIR)/$*.d -c $< -o $@

clean:
	rm -rf $(BUILD_DIR)

-include $(DEP) $(PIC_LIB_DEP)
