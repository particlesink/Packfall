# A pinned, rectangular fabric strip drapes over a fixed y-axis head pulley.
# The structure is stationary; speed is material transport seen by DEM contact.

atom_style      granular
atom_modify     map array
boundary        m m m
newton          off
communicate     single vel yes
units           si

region          domain block -0.12 0.12 -0.06 0.06 -0.01 0.12 units box
create_box      1 domain
create_atoms    1 single 0.10 0.04 0.10
set             atom 1 diameter 0.002 density 2500

neighbor        0.003 bin
neigh_modify    delay 0

fix             m1 all property/global youngsModulus peratomtype 1.e7
fix             m2 all property/global poissonsRatio peratomtype 0.30
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.2
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.5
pair_style      gran model hertz tangential history
pair_coeff      * *

timestep        5.0e-5

# Two three-roll trough stations, each with a horizontal centre roller and
# side rollers tilted +/-30 degrees about x. Mask 4 creates open roller skins.
fix trough1_centre all mesh/surface generate cylinder 0.005 0.08 32 4 type 1 &
    rotate axis 1.0 0.0 0.0 angle 90.0 move -0.04 0.0 0.02
fix trough1_left all mesh/surface generate cylinder 0.005 0.05 32 4 type 1 &
    rotate axis 1.0 0.0 0.0 angle 60.0 move -0.05 -0.028 0.024608
fix trough1_right all mesh/surface generate cylinder 0.005 0.05 32 4 type 1 &
    rotate axis 1.0 0.0 0.0 angle 120.0 move -0.05 0.028 0.024608

fix trough2_centre all mesh/surface generate cylinder 0.005 0.08 32 4 type 1 &
    rotate axis 1.0 0.0 0.0 angle 90.0 move 0.04 0.0 0.02
fix trough2_left all mesh/surface generate cylinder 0.005 0.05 32 4 type 1 &
    rotate axis 1.0 0.0 0.0 angle 60.0 move 0.03 -0.028 0.024608
fix trough2_right all mesh/surface generate cylinder 0.005 0.05 32 4 type 1 &
    rotate axis 1.0 0.0 0.0 angle 120.0 move 0.03 0.028 0.024608

# 24 x 8 cells: 384 triangles, 225 nodes. Boundary nodes remain fixed.
# The fabric references each roller mesh; its material velocity follows the
# initially-x-aligned mesh edges as the strip deforms.
fix fabric all mesh/surface/fabric generate plane 0.16 0.08 resolution 24 8 type 1 &
    move 0.0 0.0 0.04 node_mass 1.0e-5 spring_longitudinal 8.0 spring_transverse 2.0 &
    spring_shear 0.08 damping_longitudinal 0.018 damping_transverse 0.009 damping_shear 0.002 &
    bending 1.0e-5 pre_tension_longitudinal 1.0e-4 &
    gravity 0.0 0.0 -9.81 &
    support_mesh trough1_centre support_mesh trough1_left support_mesh trough1_right &
    support_mesh trough2_centre support_mesh trough2_left support_mesh trough2_right &
    speed 0.10 transport_direction 1.0 0.0 0.0 pin_boundary start_end

fix integrate all nve/sphere

dump fabric_mesh all mesh/stl 500 post/fabric_*.stl fabric
dump fabric_vtk all mesh/vtk 500 post/fabric_troughs_*.vtk fabric &
    trough1_centre trough1_left trough1_right trough2_centre trough2_left trough2_right id
thermo          500
thermo_style    custom step atoms
run             8000
